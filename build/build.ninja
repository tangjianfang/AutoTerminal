  LINK_FLAGS = /machine:x64 /INCREMENTAL:NO /subsystem:console
  LINK_LIBRARIES = autoterminal_core.lib  lib\gtest_main.lib  User32.lib  Gdi32.lib  Shell32.lib  Advapi32.lib  SetupApi.lib  Ole32.lib  Propsys.lib  Dwmapi.lib  lib\gtest.lib  kernel32.lib user32.lib gdi32.lib winspool.lib shell32.lib ole32.lib oleaut32.lib uuid.lib comdlg32.lib advapi32.lib
  OBJECT_DIR = tests\CMakeFiles\autoterminal_tests.dir
  POST_BUILD = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\tjf\github\AutoTerminal\build\tests && "C:\Program Files\CMake\bin\cmake.exe" -D TEST_TARGET=autoterminal_tests -D TEST_EXECUTABLE=C:/tjf/github/AutoTerminal/build/tests/autoterminal_tests.exe -D TEST_EXECUTOR= -D TEST_WORKING_DIR=C:/tjf/github/AutoTerminal/build/tests -D TEST_EXTRA_ARGS= -D TEST_PROPERTIES= -D TEST_PREFIX= -D TEST_SUFFIX= -D TEST_FILTER= -D NO_PRETTY_TYPES=FALSE -D NO_PRETTY_VALUES=FALSE -D TEST_LIST=autoterminal_tests_TESTS -D CTEST_FILE=C:/tjf/github/AutoTerminal/build/tests/autoterminal_tests[1]_tests.cmake -D TEST_DISCOVERY_TIMEOUT=5 -D TEST_DISCOVERY_EXTRA_ARGS= -D TEST_XML_OUTPUT_DIR= -P "C:/Program Files/CMake/share/cmake-4.2/Modules/GoogleTestAddTests.cmake""
  PRE_LINK = cd .
  RESTAT = 1
  TARGET_COMPILE_PDB = tests\CMakeFiles\autoterminal_tests.dir\
  TARGET_FILE = tests\autoterminal_tests.exe
  TARGET_IMPLIB = tests\autoterminal_tests.lib
  TARGET_PDB = tests\autoterminal_tests.pdb
  TARGET_SUPPORT_DIR = tests\CMakeFiles\autoterminal_tests.dir


